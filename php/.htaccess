# config.php nicht direkt abrufbar machen
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# Kurzer Pfad /api/usage (wie bei der Docker-Variante), falls mod_rewrite aktiv ist
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/usage$ api/usage.php [L]
</IfModule>
